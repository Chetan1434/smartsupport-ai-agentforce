<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AI_Failed_Attempts_Non_Negative</fullName>
    <active>true</active>
    <description>AI Failed Attempts can never be negative.</description>
    <errorConditionFormula>AI_Failed_Attempts__c &lt; 0</errorConditionFormula>
    <errorDisplayField>AI_Failed_Attempts__c</errorDisplayField>
    <errorMessage>AI Failed Attempts cannot be negative.</errorMessage>
</ValidationRule>
